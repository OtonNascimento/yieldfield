# Yieldfield API image (§15 — reproducible per-service images).
# Build context is the repo root so the backend package can be copied wholesale.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# uv provides the Python toolchain + dependency resolution (ADR-0001).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install dependencies first (cached) using only the lockfiles.
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./
RUN uv sync --frozen --no-install-project --no-dev

# Then the application source, and install the project itself.
COPY backend/ ./
RUN uv sync --frozen --no-dev

# Operational tooling: Alembic migrations + ClickHouse bootstrap live in ops/ so this
# image can run the one-shot `migrate` step (audit PR-3). The compose `migrate` service
# and the ops/README runbook invoke them; the server CMD below never does.
COPY ops/ ./ops/

# Run as an unprivileged user (audit M14): the app needs no root capability.
RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

EXPOSE 8000
# Invoke the venv binary directly: `uv run` would re-sync (and pull dev deps) at every
# container start — the image is frozen at build time and must stay immutable at runtime.
CMD ["/app/.venv/bin/uvicorn", "yieldfield.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
