# Yieldfield Celery worker image (§13 — out-of-band jobs).
# Identical build to the API image; only the entrypoint differs (the worker runs
# the queue consumer rather than the HTTP server).
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./
RUN uv sync --frozen --no-install-project --no-dev

COPY backend/ ./
RUN uv sync --frozen --no-dev

# Run as an unprivileged user (audit M14): the worker needs no root capability.
RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

# Invoke the venv binary directly: `uv run` would re-sync (and pull dev deps) at every
# container start — the image is frozen at build time and must stay immutable at runtime.
CMD ["/app/.venv/bin/celery", "-A", "yieldfield.workers.celery_app", "worker", "--loglevel=info"]
