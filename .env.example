# Yieldfield — example environment (§16).
#
# Copy to `.env` for local dev: `cp .env.example .env`. This file is committed and
# documents every required key; `.env` itself is git-ignored. The values below are
# LOCAL-ONLY, non-secret defaults so `docker compose up` works out of the box.
# Production secrets are supplied by a secrets manager and never committed (§11, §16).

# ── Datastores (consumed by docker-compose) ──────────────────────────────────
POSTGRES_USER=yieldfield
POSTGRES_PASSWORD=yieldfield
POSTGRES_DB=yieldfield

CLICKHOUSE_USER=yieldfield
CLICKHOUSE_PASSWORD=yieldfield
CLICKHOUSE_DB=yieldfield

# ── Backend application (YIELDFIELD_ prefix → Pydantic Settings) ──────────────
YIELDFIELD_ENVIRONMENT=local
YIELDFIELD_LOG_LEVEL=INFO
YIELDFIELD_LOG_JSON=false
# Inside compose these resolve to service names; for host-run processes use localhost.
YIELDFIELD_REDIS_URL=redis://localhost:6379/0
YIELDFIELD_DATABASE_URL=postgresql://yieldfield:yieldfield@localhost:5432/yieldfield
YIELDFIELD_CLICKHOUSE_URL=http://yieldfield:yieldfield@localhost:8123/yieldfield
YIELDFIELD_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# ── Connectors, credentials & auth (§11, §16) ────────────────────────────────
# Fernet key for connector-credential encryption at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YIELDFIELD_CREDENTIALS_KEY=
# Bearer-token → tenant map for the API auth dependency (LOCAL-ONLY example value).
YIELDFIELD_API_TOKENS={"local-dev-token":"tenant-local"}
# Gate live billing-platform pulls behind a flag.
YIELDFIELD_INGESTION_ENABLED=false
# Optional connector base-URL override (point at stripe-mock locally; leave unset for live).
YIELDFIELD_CONNECTOR_BASE_URL=

# ── Frontend (only VITE_-prefixed vars ever reach the browser bundle, §16) ───
VITE_API_BASE_URL=http://localhost:8000
VITE_ENVIRONMENT=local
